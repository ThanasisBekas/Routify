# ========================
# Environment / Secrets
# ========================
# Root .env files are gitignored (copy from environments/ for local use)
.env
.env.*
!.env.example
!.env.*.example

# environments/ folder — secret files are tracked intentionally by the
# "Generate .env" CI workflow (committed with git add -f).
# They are excluded here so accidental `git add .` never leaks secrets.
environments/.env.*
!environments/README.md

# ========================
# Java / Maven
# ========================
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.log
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*

# MaxMind GeoLite2 database (binary, requires MaxMind account to download)
*.mmdb

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ========================
# Frontend (Vite / React)
# ========================
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ========================
# IDE - IntelliJ IDEA
# ========================
# Ignore most of .idea, but keep shareable project-level settings
.idea/
!.idea/compiler.xml
!.idea/encodings.xml
!.idea/jarRepositories.xml
!.idea/misc.xml
# Never commit data source credentials or workspace state
.idea/dataSources/
.idea/dataSources.local.xml
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
*.iws
*.iml
*.ipr
out/

# IDE - VS Code
.vscode/

# ========================
# OS
# ========================
.DS_Store
Thumbs.db