# ─── Routify — Environment Variables ───────────────────────────────────────────
#
# Copy this file to .env and fill in the required values:
#
#   cp .env.example .env
#
# Then start infrastructure:
#   docker compose --env-file .env up -d
#
# For the full containerised stack (requires `mvn clean package -DskipTests` first):
#   docker compose -f docker-compose.yml -f docker-compose.app.yml --env-file .env up -d
#
# IntelliJ run configurations auto-load environments/.env.develop — if that file
# is missing, copy your root .env:  cp .env environments/.env.develop
#
# For production, inject secrets via Kubernetes Secrets or Vault — never commit
# real credentials to version control.
# ───────────────────────────────────────────────────────────────────────────────

# ─── Required: Infrastructure Credentials ─────────────────────────────────────

# PostgreSQL password for the 'routify' user (shared across all schemas).
DB_PASS=changeme

# RabbitMQ password for the 'routify' user.
RABBITMQ_PASS=changeme

# Redis password (--requirepass). Used by admin-api, api-gateway, identity-service,
# route-service, and ai-service.
REDIS_PASS=changeme

# ─── Required: JWT Signing Keys ───────────────────────────────────────────────
# RSA-2048 keypair. Identity-service signs JWTs with the private key; all other
# services verify with the public key.
#
# Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER | base64 -w0
#   openssl pkey -pubout -outform DER -in <(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform PEM) | base64 -w0
#
# Or use the "Generate .env" GitHub Actions workflow which auto-generates these.

# RSA-2048 private key (PKCS8, DER, base64-encoded) — identity-service only.
JWT_PRIVATE_KEY=

# RSA-2048 public key (SPKI, DER, base64-encoded) — all services.
JWT_PUBLIC_KEY=

# ─── Required: Cert-Vault Encryption ──────────────────────────────────────────

# AES-256 key (32 bytes, base64-encoded) for encrypting certificate material at rest.
# Generate with:  openssl rand -base64 32
CERT_VAULT_ENCRYPTION_KEY=

# ─── Required: Field-Level Encryption ─────────────────────────────────────────

# AES-256 key (32 bytes, base64-encoded) for encrypting @Sensitive entity fields at rest.
# Used by identity-service, route-service, audit-service, and cert-vault.
# Generate with:  openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ─── Optional: Identity Service ───────────────────────────────────────────────

# Initial password for the seeded admin user (identity-service DataSeeder).
# If blank, the DataSeeder generates a random password logged at startup.
ADMIN_INITIAL_PASSWORD=

# ─── Optional: AI Service (OpenAI) ────────────────────────────────────────────

# OpenAI API key. Required if routify-ai-service is running.
# Fail-fast at startup if absent (validated via routify.required-secrets).
OPENAI_API_KEY=

# OpenAI model to use (default: gpt-4o-mini). Override with e.g. gpt-4o.
# OPENAI_MODEL=gpt-4o-mini

# Hard timeout for OpenAI API calls in seconds (default: 10).
# OPENAI_TIMEOUT_SECONDS=10

# Fallback action when AI evaluation fails or times out (default: ALLOW).
# Options: ALLOW, BLOCK
# AI_FALLBACK_ACTION=ALLOW

# RabbitMQ listener concurrency for AI evaluation queues (default: 8).
# RABBITMQ_CONCURRENCY=8

# ─── Optional: Observability ──────────────────────────────────────────────────

# Grafana admin password (default: admin).
GRAFANA_PASSWORD=admin

# Tracing sampling probability for all services (default: 1.0 = 100%).
# Set to 0.1 for 10% sampling in production.
# TRACING_SAMPLING_PROBABILITY=1.0

# OTLP exporter endpoint for distributed tracing (default: http://localhost:4318/v1/traces).
# In docker-compose.app.yml this is overridden per-service to http://tempo:4318/v1/traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

