# Routify Dashboard — Development mode (non-mock)
# VITE_API_BASE_URL is intentionally left unset so that apiClient uses relative
# URLs and all /api/* requests are handled by the Vite dev-server proxy
# (see vite.config.ts), keeping the browser origin consistent at localhost:5173.
# Cookies (refresh_token) are therefore stored and sent on the correct origin.
#
# To point the dashboard at a remote backend set this to the full URL, e.g.:
# VITE_API_BASE_URL=https://api.your-staging.example.com
VITE_MOCK=false

