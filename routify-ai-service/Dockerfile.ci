# Dockerfile.ci — Lean CI image for routify-ai-service
# Expects the JAR to already be built: mvn package -pl routify-ai-service -am -DskipTests
# Usage: docker build -f routify-ai-service/Dockerfile.ci routify-ai-service/
FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S routify && adduser -S routify -G routify
USER routify
WORKDIR /app
COPY target/*.jar app.jar
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseZGC -XX:+ZGenerational --enable-preview -Dspring.threads.virtual.enabled=true"
EXPOSE 8086 9086
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=3 \
  CMD wget -qO- http://localhost:9086/actuator/health || exit 1
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

