# Dockerfile.ci — Lean CI image for routify-cert-vault
# Expects the JAR to already be built: mvn package -pl routify-cert-vault -am -DskipTests
# Usage: docker build -f routify-cert-vault/Dockerfile.ci routify-cert-vault/
FROM eclipse-temurin:25-jre-alpine
RUN addgroup -S routify && adduser -S routify -G routify
USER routify
WORKDIR /app
COPY target/*.jar app.jar
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseZGC -Dspring.threads.virtual.enabled=true"
EXPOSE 8085 9085
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:9085/actuator/health || exit 1
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

