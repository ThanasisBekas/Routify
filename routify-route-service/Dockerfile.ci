# Dockerfile.ci — Lean CI image for routify-route-service
# Expects the JAR to already be built: mvn package -pl routify-route-service -am -DskipTests
# Usage: docker build -f routify-route-service/Dockerfile.ci routify-route-service/
FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S routify && adduser -S routify -G routify
USER routify
WORKDIR /app
COPY target/*.jar app.jar
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseZGC -XX:+ZGenerational --enable-preview -Dspring.threads.virtual.enabled=true"
EXPOSE 8081 9081
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:9081/actuator/health || exit 1
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

